#!/bin/zsh
# ***************************************************************
# Local API tokens and secrets — NOT committed to git.
#
# Setup:
#   cp "$DOTFILES_DIR/zsh/secrets.sh.example" "$DOTFILES_DIR/zsh/secrets.sh"
#   chmod 600 "$DOTFILES_DIR/zsh/secrets.sh"
# Then edit secrets.sh and replace the empty strings with real values.
#
# Sourced from tools.sh when secrets.sh exists.
# ***************************************************************

# Buildkite (MCP)
export BUILDKITE_API_TOKEN=""

# Atlassian Jira (MCP)
export JIRA_URL=""
export JIRA_USERNAME=""
export JIRA_API_TOKEN=""

# Atlassian Confluence (MCP)
export CONFLUENCE_URL=""
export CONFLUENCE_USERNAME=""
export CONFLUENCE_API_TOKEN=""

# Rollbar (MCP)
export ROLLBAR_ACCESS_TOKEN=""
